# Publishable API key for the Medusa backend. Required for the storefront to function.
# One key per SPECS sub-brand, created by apps/backend's seed script.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region code to use for the storefront
NEXT_PUBLIC_DEFAULT_REGION=id

# Base URL of the storefront (used for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Fallback branding/copy preset (src/lib/store-config.ts), used only when the backend
# has no Storefront record for this publishable key. Live copy is edited in the Medusa
# admin under Storefronts. "specs-teamsport" | "specs-run"
NEXT_PUBLIC_STORE_KEY=specs-teamsport

# Note: package.json's dev/start scripts hardcode -p 8000 (Next.js decides
# the port before .env files load, so PORT= here has no effect). Run a
# second local instance for the other store directly, e.g.:
#   npx next dev --turbopack -p 8001
# with NEXT_PUBLIC_STORE_KEY=specs-run and that store's publishable key
# overridden via shell env for that process.

# Stripe publishable key for payment processing (optional, only if using Stripe)
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# Node environment (development, production, etc.)
NODE_ENV=development
